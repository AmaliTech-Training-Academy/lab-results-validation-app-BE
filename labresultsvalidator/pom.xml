<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.amalitech</groupId>
    <artifactId>labresultsvalidator</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name/>
    <description/>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <!-- Override the Spring Boot-managed embedded Tomcat to patch the
             CRITICAL/HIGH CVEs flagged by Trivy (CVE-2026-41293, -43512,
             -43515, -41284, -42498, -43513). Fixed in 11.0.22. -->
        <tomcat.version>11.0.22</tomcat.version>
        <!-- Override Netty to patch HIGH CVEs: CVE-2026-42579 (DNS domain name
             constraint handling), CVE-2026-44249 (IPv6 subnet filter bypass),
             CVE-2026-45416 (SNI handler over-allocation), CVE-2026-45674 and
             CVE-2026-47691 (DNS cache poisoning / bailiwick checks).
             Fixed in 4.2.15.Final. -->
        <netty.version>4.2.15.Final</netty.version>
        <!-- Override the Spring Boot-managed Jackson 3 (tools.jackson) line to patch
             HIGH CVEs CVE-2026-54512 (PolymorphicTypeValidator bypass via generic type
             parameters) and CVE-2026-54513 (array subtype allowlist bypass in
             BasicPolymorphicTypeValidator). Fixed in 3.1.4. The Jackson 2 line is
             pinned separately via the jackson-bom import below. -->
        <jackson-bom.version>3.1.4</jackson-bom.version>
        <!-- Pin all Kiota transitive deps (pulled by microsoft-graph 6.3.0) to patch
             CVE-2026-44503 (HIGH): RedirectHandler leaks Cookie/Proxy-Authorization
             headers on cross-host redirect. Fixed in 1.9.1. -->
        <kiota.version>1.9.1</kiota.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <!-- Pinned above the Spring Boot-managed version to patch
                 CVE-2026-54291 (HIGH). Fixed in 42.7.12. -->
            <version>42.7.12</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
            <version>4.0.0-M1</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.2</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Use the standard test starter (includes JUnit Jupiter, Spring Test, Mockito, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/com.opencsv/opencsv -->
        <dependency>
            <groupId>com.opencsv</groupId>
            <artifactId>opencsv</artifactId>
            <version>5.12.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- Microsoft Graph SDK (Graph REST calls) -->
        <dependency>
            <groupId>com.microsoft.graph</groupId>
            <artifactId>microsoft-graph</artifactId>
            <version>6.3.0</version>
        </dependency>
        <!-- Azure Identity (client-credentials token acquisition).
             Exclude azure-core-http-netty to avoid binary incompatibility with
             Netty 4.2.x (pulled by Spring Boot 4); use OkHttp instead. -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <version>1.15.4</version>
            <exclusions>
                <exclusion>
                    <groupId>com.azure</groupId>
                    <artifactId>azure-core-http-netty</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-core-http-okhttp</artifactId>
            <version>1.12.9</version>
        </dependency>
        <!-- Apache POI — local XLSX parse (PRD D-READ decision) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- Pin the entire Jackson 2 (com.fasterxml.jackson) family to patch HIGH
                 CVEs CVE-2026-54512 and CVE-2026-54513 in jackson-databind. The
                 Spring Boot-managed version (2.21.2, pulled transitively via
                 jjwt-jackson and the jackson-dataformat/datatype artifacts) is not
                 exposed through a single overridable property, so import the patched
                 BOM directly. Fixed in 2.21.4. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.21.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Force all Kiota modules to 1.9.1 to patch CVE-2026-44503 (HIGH).
                 microsoft-graph 6.3.0 pulls 1.0.3 transitively. -->
            <dependency>
                <groupId>com.microsoft.kiota</groupId>
                <artifactId>microsoft-kiota-abstractions</artifactId>
                <version>${kiota.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.kiota</groupId>
                <artifactId>microsoft-kiota-authentication-azure</artifactId>
                <version>${kiota.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.kiota</groupId>
                <artifactId>microsoft-kiota-http-okHttp</artifactId>
                <version>${kiota.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.kiota</groupId>
                <artifactId>microsoft-kiota-serialization-json</artifactId>
                <version>${kiota.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.kiota</groupId>
                <artifactId>microsoft-kiota-serialization-text</artifactId>
                <version>${kiota.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.kiota</groupId>
                <artifactId>microsoft-kiota-serialization-form</artifactId>
                <version>${kiota.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.kiota</groupId>
                <artifactId>microsoft-kiota-serialization-multipart</artifactId>
                <version>${kiota.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Ensure Surefire can run JUnit Jupiter -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M8</version>
                <configuration>
                    <!-- Allow Mockito to self-attach on Linux/CI (Java 21 strict mode) -->
                    <argLine>@{argLine} -Djdk.attach.allowAttachSelf=true</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <failsOnError>true</failsOnError>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                </configuration>
            </plugin>

            <!-- JaCoCo: produces target/site/jacoco/jacoco.xml, which SonarQube
                 auto-detects to evaluate the coverage condition of the quality gate. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
