variable "tags" {
  type        = map(string)
  default     = {}
  description = "Tags applied to taggable resources."
}

variable "ssm_prefix" {
  type        = string
  description = "SSM path prefix (e.g. /labresults/dev). Every parameter is created under this path."
}

variable "config_values" {
  type        = map(string)
  default     = {}
  description = "Non-secret config, written as SSM String parameters under ssm_prefix. Key is the env var name (e.g. DB_HOST), value is the literal config value."
}

variable "external_secret_names" {
  type        = list(string)
  default     = []
  description = "Names of secrets that come from external systems (DB, mail, Azure, AWS creds) and can't be generated by Terraform. Declared as placeholder SecureString parameters — set real values with aws ssm put-parameter --overwrite."
}
