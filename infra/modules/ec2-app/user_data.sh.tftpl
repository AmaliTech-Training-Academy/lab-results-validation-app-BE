#!/bin/bash
# Bootstraps the dev box (Ubuntu): installs Docker + Compose, the AWS CLI, and writes the
# compose file + a refresh-env.sh helper. The box has an SSM-only instance role and reads its
# .env directly from SSM Parameter Store (${ssm_prefix}/*) — CI just triggers refresh-env.sh
# over SSM; changing a config value is one `aws ssm put-parameter --overwrite` away, no CI edit.
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y docker.io unzip curl jq
systemctl enable --now docker

# AWS CLI v2 (apt's awscli is v1 and stale on Ubuntu). refresh-env.sh uses this to read
# Parameter Store.
curl -sSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/awscliv2.zip /tmp/aws

# Let the 'ubuntu' SSH user run docker without sudo (CI connects as ubuntu).
usermod -aG docker ubuntu

# Docker Compose v2 plugin (static binary)
mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

APP_DIR=/opt/app
mkdir -p "$${APP_DIR}"

# Rebuilds .env from every parameter under ${ssm_prefix} (decrypted). CI's SSM deploy command
# runs this before `docker compose up`, so a value changed with `aws ssm put-parameter
# --overwrite` takes effect on the next deploy with no CI/workflow edit needed.
cat > "$${APP_DIR}/refresh-env.sh" <<'SCRIPT'
#!/bin/bash
set -eu
PREFIX="${ssm_prefix}"
REGION="${aws_region}"

aws ssm get-parameters-by-path \
  --path "$PREFIX" --with-decryption --recursive --region "$REGION" \
  --query "Parameters[].{Name:Name,Value:Value}" --output json \
| jq -r --arg prefix "$PREFIX/" '.[] | "\(.Name | sub("^" + $prefix; ""))=\(.Value)"' \
  > /opt/app/.env

chown ubuntu:ubuntu /opt/app/.env
chmod 600 /opt/app/.env

# The certificate hostname comes from the same parameter set, so re-render the Caddyfile here.
# `docker compose up -d` then restarts Caddy only if the file actually changed.
if [ -x /opt/app/render-caddyfile.sh ]; then
  /opt/app/render-caddyfile.sh
fi
SCRIPT
chmod +x "$${APP_DIR}/refresh-env.sh"

# The deployment stack. refresh-env.sh supplies .env; CI's SSM command then runs
# `docker compose pull && up -d`.
cat > "$${APP_DIR}/docker-compose.yml" <<EOF
services:
  redis:
    image: redis:7-alpine
    restart: unless-stopped
  app:
    image: ${backend_repo}:${image_tag}
    restart: unless-stopped
    env_file: .env
    # Exposed on 8080 for on-box debugging only; the security group does not open
    # 8080 externally. Public traffic reaches the API via the frontend's /api proxy.
    ports:
      - "8080:8080"
    depends_on:
      - redis
  frontend:
    image: ${frontend_repo}:${image_tag}
    restart: unless-stopped
    # nginx listens on 8080 in the container; serves the SPA and proxies /api -> app:8080.
    # No host port: Caddy terminates TLS on 80/443 and proxies to it over the compose network.
    expose:
      - "8080"
    depends_on:
      - app
  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    # Caddy obtains and renews a Let's Encrypt certificate on its own. It needs 80 reachable
    # from the internet for the ACME HTTP-01 challenge, not just for the redirect.
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      # Certificates and the ACME account key live here. Losing this volume means re-issuing,
      # and Let's Encrypt rate-limits duplicate certificates (5 per week per hostname), so it
      # must survive container restarts.
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - frontend

volumes:
  caddy_data:
  caddy_config:
EOF

# APP_DOMAIN is written by refresh-env.sh from SSM. Caddy needs the hostname at startup to
# request the certificate, and it cannot read .env, so the Caddyfile is rendered from that
# value instead of hardcoding a domain into the AMI bootstrap.
cat > "$${APP_DIR}/render-caddyfile.sh" <<'SCRIPT'
#!/bin/bash
set -eu
APP_DIR=/opt/app

# shellcheck disable=SC1091
DOMAIN=$(grep -E '^APP_DOMAIN=' "$APP_DIR/.env" | cut -d= -f2- || true)

if [ -z "$${DOMAIN:-}" ]; then
  echo "APP_DOMAIN is not set in .env — serving plain HTTP on :80 without a certificate." >&2
  # `http://` prefix tells Caddy to serve HTTP only and skip ACME entirely. Without this the
  # box would sit in a failing certificate-request loop before a domain has been pointed at it.
  SITE="http://"
else
  SITE="$DOMAIN"
fi

cat > "$APP_DIR/Caddyfile" <<CADDY
$SITE {
    encode zstd gzip
    # The SPA and its /api proxy are both served by the frontend nginx, so one upstream is
    # enough — Caddy only adds TLS in front of it.
    reverse_proxy frontend:8080
}
CADDY

chown ubuntu:ubuntu "$APP_DIR/Caddyfile"
SCRIPT
chmod +x "$${APP_DIR}/render-caddyfile.sh"

# Render once now so the stack can start before the first deploy runs.
touch "$${APP_DIR}/.env"
"$${APP_DIR}/render-caddyfile.sh"

chown -R ubuntu:ubuntu "$${APP_DIR}"
