#!/bin/bash
# Bootstraps the dev box (Ubuntu): installs Docker + Compose, the AWS CLI, and writes the
# compose file. The box has an SSM-only instance role — CI stages /opt/app/.env in a private
# S3 bucket and sends an SSM command that pulls it down (aws s3 cp) and deploys the stack.
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y docker.io unzip curl
systemctl enable --now docker

# AWS CLI v2 (apt's awscli is v1 and stale on Ubuntu). The SSM-run deploy script uses this
# to pull the staged .env from S3.
curl -sSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/awscliv2.zip /tmp/aws

# Let the 'ubuntu' SSH user run docker without sudo (CI connects as ubuntu).
usermod -aG docker ubuntu

# Docker Compose v2 plugin (static binary)
mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

APP_DIR=/opt/app
mkdir -p "$${APP_DIR}"

# The deployment stack. CI supplies .env and runs `docker compose pull && up -d` over SSH.
cat > "$${APP_DIR}/docker-compose.yml" <<EOF
services:
  redis:
    image: redis:7-alpine
    restart: unless-stopped
  app:
    image: ${backend_repo}:${image_tag}
    restart: unless-stopped
    env_file: .env
    # Exposed on 8080 for on-box debugging only; the security group does not open
    # 8080 externally. Public traffic reaches the API via the frontend's /api proxy.
    ports:
      - "8080:8080"
    depends_on:
      - redis
  frontend:
    image: ${frontend_repo}:${image_tag}
    restart: unless-stopped
    # nginx listens on 8080 in the container; serves the SPA and proxies /api -> app:8080.
    ports:
      - "80:8080"
    depends_on:
      - app
EOF

chown -R ubuntu:ubuntu "$${APP_DIR}"
