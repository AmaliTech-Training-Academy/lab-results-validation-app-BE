#!/bin/bash
# Bootstraps the dev box (Ubuntu): installs Docker + Compose, the AWS CLI, and writes the
# compose file + a refresh-env.sh helper. The box has an SSM-only instance role and reads its
# .env directly from SSM Parameter Store (${ssm_prefix}/*) — CI just triggers refresh-env.sh
# over SSM; changing a config value is one `aws ssm put-parameter --overwrite` away, no CI edit.
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y docker.io unzip curl jq
systemctl enable --now docker

# AWS CLI v2 (apt's awscli is v1 and stale on Ubuntu). refresh-env.sh uses this to read
# Parameter Store.
curl -sSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/awscliv2.zip /tmp/aws

# Let the 'ubuntu' SSH user run docker without sudo (CI connects as ubuntu).
usermod -aG docker ubuntu

# Docker Compose v2 plugin (static binary)
mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

APP_DIR=/opt/app
mkdir -p "$${APP_DIR}"

# Rebuilds .env from every parameter under ${ssm_prefix} (decrypted). CI's SSM deploy command
# runs this before `docker compose up`, so a value changed with `aws ssm put-parameter
# --overwrite` takes effect on the next deploy with no CI/workflow edit needed.
cat > "$${APP_DIR}/refresh-env.sh" <<'SCRIPT'
#!/bin/bash
set -eu
PREFIX="${ssm_prefix}"
REGION="${aws_region}"

aws ssm get-parameters-by-path \
  --path "$PREFIX" --with-decryption --recursive --region "$REGION" \
  --query "Parameters[].{Name:Name,Value:Value}" --output json \
| jq -r --arg prefix "$PREFIX/" '.[] | "\(.Name | sub("^" + $prefix; ""))=\(.Value)"' \
  > /opt/app/.env

chown ubuntu:ubuntu /opt/app/.env
chmod 600 /opt/app/.env
SCRIPT
chmod +x "$${APP_DIR}/refresh-env.sh"

# The deployment stack. refresh-env.sh supplies .env; CI's SSM command then runs
# `docker compose pull && up -d`.
cat > "$${APP_DIR}/docker-compose.yml" <<EOF
services:
  redis:
    image: redis:7-alpine
    restart: unless-stopped
  app:
    image: ${backend_repo}:${image_tag}
    restart: unless-stopped
    env_file: .env
    # Exposed on 8080 for on-box debugging only; the security group does not open
    # 8080 externally. Public traffic reaches the API via the frontend's /api proxy.
    ports:
      - "8080:8080"
    depends_on:
      - redis
  frontend:
    image: ${frontend_repo}:${image_tag}
    restart: unless-stopped
    # nginx listens on 8080 in the container; serves the SPA and proxies /api -> app:8080.
    ports:
      - "80:8080"
    depends_on:
      - app
EOF

chown -R ubuntu:ubuntu "$${APP_DIR}"
